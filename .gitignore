# Role runtime state - never commit (memories, sessions, inbox, logs, backups)
# All state lives in state/ subdirectory next to ROLE.md
.agents/roles/*/state/
.agents/roles/*/skills/*/references/

# Safety net: catch any state files mistakenly placed at the role root
.agents/roles/*/memories.md
.agents/roles/*/sessions.md
.agents/roles/*/inbox/
.agents/roles/*/logs/

# macOS metadata
.DS_Store

# Team-specific skill overlays - never commit
.agents/skills/*/references/

# Machine-specific path config - create locally after cloning
.agents/references/local.md

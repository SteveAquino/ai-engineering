# Private role state - never commit
.agents/roles/*/memories.md
.agents/roles/*/memories.md.pre-dream-*
.agents/roles/*/sessions.md
.agents/roles/*/team-config.json
.agents/roles/*/weekly-retros/

# Role runtime state - inbox, logs, and scheduler state never committed
.agents/roles/*/inbox/
.agents/roles/*/logs/
.agents/roles/scheduling-assistant/crontab.json

# Team-specific skill overlays - never commit
.agents/skills/*/references/

# Machine-specific path config - create locally after cloning
.agents/references/local.md
